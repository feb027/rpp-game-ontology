  <rdf:Description rdf:about="http://example.org/game-recommendation#Recommendation_CounterStrike_Competitive_PC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/game-recommendation#Recommendation"/>
    <rdfs:label>Recommendation_CounterStrike_Competitive_PC</rdfs:label>
    <recommendsGame rdf:resource="http://example.org/game-recommendation#CounterStrike2"/>
    <basedOnMood rdf:resource="http://example.org/game-recommendation#Kompetitif"/>
    <basedOnPreference rdf:resource="http://example.org/game-recommendation#PreferFPS"/>
    <basedOnPreference rdf:resource="http://example.org/game-recommendation#PreferPC"/>
    <basedOnPreference rdf:resource="http://example.org/game-recommendation#PreferMultiplayer"/>
    <basedOnPreference rdf:resource="http://example.org/game-recommendation#PreferSingkat"/>
    <basedOnPreference rdf:resource="http://example.org/game-recommendation#PreferSulit"/>
    <priorityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</priorityScore>
    <recommendationReason xml:lang="id">Counter-Strike 2 direkomendasikan sebagai opsi kompetitif FPS karena tersedia di PC, mode Multiplayer, sesi Singkat/Sedang, dan difficulty Sulit.</recommendationReason>
  </rdf:Description>
