<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/game-recommendation#"
     xml:base="http://example.org/game-recommendation"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/game-recommendation"/>

    <owl:Class rdf:about="#Game"/>
    <owl:Class rdf:about="#Genre"/>
    <owl:Class rdf:about="#Mood"/>
    <owl:Class rdf:about="#Platform"/>
    <owl:Class rdf:about="#PlayMode"/>
    <owl:Class rdf:about="#Difficulty"/>
    <owl:Class rdf:about="#Duration"/>
    <owl:Class rdf:about="#PlayerPreference"/>
    <owl:Class rdf:about="#Recommendation"/>

    <owl:ObjectProperty rdf:about="#hasGenre"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#Genre"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#availableOn"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#Platform"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasPlayMode"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#PlayMode"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDifficulty"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#Difficulty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDuration"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#Duration"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#suitableForMood"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="#Mood"/></owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#gameTitle"><rdfs:domain rdf:resource="#Game"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="#Santai"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Kompetitif"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Stres"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Bosan"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Eksploratif"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Sosial"><rdf:type rdf:resource="#Mood"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Simulation"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Casual"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#RPG"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#FPS"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Adventure"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Puzzle"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PC"><rdf:type rdf:resource="#Platform"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Mobile"><rdf:type rdf:resource="#Platform"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Console"><rdf:type rdf:resource="#Platform"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SinglePlayer"><rdf:type rdf:resource="#PlayMode"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Multiplayer"><rdf:type rdf:resource="#PlayMode"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Coop"><rdf:type rdf:resource="#PlayMode"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Mudah"><rdf:type rdf:resource="#Difficulty"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Sedang"><rdf:type rdf:resource="#Difficulty"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Sulit"><rdf:type rdf:resource="#Difficulty"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Singkat"><rdf:type rdf:resource="#Duration"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Panjang"><rdf:type rdf:resource="#Duration"/></owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#StardewValley">
        <rdf:type rdf:resource="#Game"/>
        <gameTitle>Stardew Valley</gameTitle>
        <hasGenre rdf:resource="#Simulation"/>
        <hasGenre rdf:resource="#Casual"/>
        <suitableForMood rdf:resource="#Santai"/>
        <suitableForMood rdf:resource="#Stres"/>
        <availableOn rdf:resource="#PC"/>
        <hasPlayMode rdf:resource="#SinglePlayer"/>
        <hasDifficulty rdf:resource="#Mudah"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Valorant">
        <rdf:type rdf:resource="#Game"/>
        <gameTitle>Valorant</gameTitle>
        <hasGenre rdf:resource="#FPS"/>
        <suitableForMood rdf:resource="#Kompetitif"/>
        <availableOn rdf:resource="#PC"/>
        <hasPlayMode rdf:resource="#Multiplayer"/>
        <hasDifficulty rdf:resource="#Sulit"/>
    </owl:NamedIndividual>
</rdf:RDF>
